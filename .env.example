DATABASE_URL=
JWT_SECRET=
# Verified sender and Resend API key. Never expose these as EXPO_PUBLIC variables.
RESEND_API_KEY=
EMAIL_FROM=LuminaPortal <accounts@your-domain.example>
APP_URL=http://127.0.0.1:4189

# Separate encryption key; keep a secure copy away from the backups.
BACKUP_ENCRYPTION_KEY=
# Only for recovery into a separate empty migrated database.
RESTORE_DATABASE_URL=
